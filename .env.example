# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hu_fellowship_library"

# Session Security
SESSION_SECRET="hu-fellowship-session-secret-change-in-production"

# Server Port
PORT=5000

# Environment
NODE_ENV="development"

# Backblaze B2 Private Storage (S3-Compatible API)
# Obtain these values from your Backblaze B2 Bucket and App Key configuration
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME="hu-fellowship-library"
B2_ENDPOINT=""
B2_REGION=""
