# 27. DATABASE DESIGN

Create database:

```text
********
```

Use MySQL.

---

# 28. USERS TABLE

Use:

```sql
CREATE TABLE users (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    phone VARCHAR(30) NOT NULL,
    password VARCHAR(255) NOT NULL,
    school_year VARCHAR(30) NOT NULL,
    department VARCHAR(150) NOT NULL,
    role ENUM('member', 'admin') DEFAULT 'member',
    status ENUM('active', 'inactive') DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP
);
```

---

# 29. CATEGORIES TABLE

```sql
CREATE TABLE categories (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL UNIQUE,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
```

Seed the database with:

```text
Summer Bible Study Notes
```

You may also include useful categories such as:

```text
Christian Living
Bible Commentary
Theology
Devotional
Leadership
Biography
```

But ensure:

```text
Summer Bible Study Notes
```

exists.

---

# 30. BOOKS TABLE

Use:

```sql
CREATE TABLE books (
    id INT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(255) NOT NULL,
    author VARCHAR(150) NOT NULL,
    isbn VARCHAR(50),
    category_id INT,
    book_type ENUM('hardcopy', 'softcopy') NOT NULL,
    description TEXT,
    publisher VARCHAR(150),
    publication_year INT,
    quantity INT NULL,
    available_quantity INT NULL,
    cover_image VARCHAR(500),
    file_url VARCHAR(500),
    location VARCHAR(150),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (category_id)
        REFERENCES categories(id)
        ON DELETE SET NULL
);
```

---

# 31. BORROWING REQUESTS TABLE

Use:

```sql
CREATE TABLE borrowing_requests (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    book_id INT NOT NULL,

    requester_name VARCHAR(100) NOT NULL,
    phone_number VARCHAR(30) NOT NULL,
    school_year VARCHAR(30) NOT NULL,
    department VARCHAR(150) NOT NULL,

    requested_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    status ENUM(
        'pending',
        'approved',
        'rejected'
    ) DEFAULT 'pending',

    rejection_reason TEXT,

    processed_at TIMESTAMP NULL,
    processed_by INT NULL,

    FOREIGN KEY (user_id)
        REFERENCES users(id),

    FOREIGN KEY (book_id)
        REFERENCES books(id),

    FOREIGN KEY (processed_by)
        REFERENCES users(id)
);
```

---

# 32. BORROWINGS TABLE

```sql
CREATE TABLE borrowings (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    book_id INT NOT NULL,

    borrowed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    due_date DATE NOT NULL,
    returned_at TIMESTAMP NULL,

    status ENUM(
        'borrowed',
        'returned',
        'overdue'
    ) DEFAULT 'borrowed',

    return_requested_at TIMESTAMP NULL,

    notes TEXT,

    FOREIGN KEY (user_id)
        REFERENCES users(id),

    FOREIGN KEY (book_id)
        REFERENCES books(id)
);
```

---

# 33. DATABASE INDEXES

Add appropriate indexes:

```sql
CREATE INDEX idx_books_title
ON books(title);

CREATE INDEX idx_books_author
ON books(author);

CREATE INDEX idx_books_category
ON books(category_id);

CREATE INDEX idx_books_type
ON books(book_type);

CREATE INDEX idx_borrowings_user
ON borrowings(user_id);

CREATE INDEX idx_borrowings_book
ON borrowings(book_id);

CREATE INDEX idx_borrowings_status
ON borrowings(status);

CREATE INDEX idx_requests_user
ON borrowing_requests(user_id);

CREATE INDEX idx_requests_book
ON borrowing_requests(book_id);

CREATE INDEX idx_requests_status
ON borrowing_requests(status);
```

