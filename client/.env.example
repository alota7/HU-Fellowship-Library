# Public frontend configuration only. Never put secrets in this file.

# Base URL of the future backend API.
VITE_API_BASE_URL=http://localhost:5000/api

# When true, the frontend talks to the in-browser mock adapter instead of the API.
# Set to false once the real backend is available.
VITE_USE_MOCK_API=true

# Optional: in mock mode only, an account registered with this email is treated
# as an administrator. No password is stored in the frontend.
VITE_MOCK_ADMIN_EMAIL=
